<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:chart="urn:oasis:names:tc:opendocument:xmlns:chart:1.0" xmlns:presentation="urn:oasis:names:tc:opendocument:xmlns:presentation:1.0" xmlns:of="urn:oasis:names:tc:opendocument:xmlns:of:1.2" xmlns:dr3d="urn:oasis:names:tc:opendocument:xmlns:dr3d:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.presentation">
<office:automatic-styles><style:page-layout style:name="PM0"><style:page-layout-properties fo:page-width="25.4cm" fo:page-height="19.05cm" style:print-orientation="landscape"/></style:page-layout><style:style style:name="Col" style:family="table-column"><style:table-column-properties style:column-width="3cm"/></style:style></office:automatic-styles><office:master-styles><style:master-page style:name="Default" style:page-layout-name="PM0"/></office:master-styles><office:body>
<office:presentation>
<draw:page draw:name="page1" draw:master-page-name="Default">
<draw:frame svg:x="1cm" svg:y="0.5cm" svg:width="12cm" svg:height="1.2cm"><draw:text-box><text:p>Deck title</text:p></draw:text-box></draw:frame>
<draw:frame svg:x="1cm" svg:y="2cm" svg:width="10cm" svg:height="2cm"><draw:text-box><text:p>Point one</text:p><text:p>Point two{{ drop("paragraph") if not two }}</text:p><text:p>Point three</text:p></draw:text-box></draw:frame>
<draw:frame svg:x="1cm" svg:y="5cm" svg:width="12cm" svg:height="1.4cm"><table:table><table:table-column table:style-name="Col" table:number-columns-repeated="4"/>
<table:table-row><table:table-cell office:value-type="string"><text:p>Item</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Qty</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Discount{{ drop("column") if not discount }}</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Amount</text:p></table:table-cell></table:table-row>
<table:table-row><table:table-cell office:value-type="string"><text:p>{% for i in items %}{{ i.name }}{{ drop("row") if i.hidden }}</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>{{ i.qty }}</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>{{ i.discount }}</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>{{ i.amount }}{% endfor %}</text:p></table:table-cell></table:table-row>
</table:table></draw:frame>
<draw:frame svg:x="1cm" svg:y="10cm" svg:width="6cm" svg:height="2cm"><table:table><table:table-column table:style-name="Col" table:number-columns-repeated="2"/>
<table:table-row><table:table-cell office:value-type="string"><text:p>Notes table{{ drop("table") if not notes }}</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Kept only with notes</text:p></table:table-cell></table:table-row>
</table:table></draw:frame>
<draw:frame draw:name="Logo"  svg:width="1.5cm" svg:height="1.5cm" svg:x="20cm" svg:y="0.5cm"><draw:image><office:binary-data>iVBORw0KGgoAAAANSUhEUgAAADAAAAAwCAIAAADYYG7QAAAARUlEQVR4nO3OMQ0AIAwAsCnhnggkIhYJiNixkTSpgEbmHiXaB0KV0D2rhZCQkJCQkJCQkJCQkJCQkJCQkJCQkNAUQt+FHsUvhCYWKlj4AAAAAElFTkSuQmCC</office:binary-data></draw:image><svg:title>Company logo</svg:title><svg:desc>{{ drop("picture") if not logo }}</svg:desc></draw:frame>
<draw:frame draw:name="Sales chart"  svg:width="8cm" svg:height="5cm" svg:x="15cm" svg:y="4cm"><draw:object><office:document office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.chart"><office:automatic-styles><style:style style:name="chMain" style:family="chart"><style:graphic-properties draw:stroke="none" draw:fill="solid" draw:fill-color="#ffffff"/></style:style><style:style style:name="chTitle" style:family="chart"><style:text-properties fo:font-size="13pt" fo:font-weight="bold"/></style:style><style:style style:name="chLegend" style:family="chart"><style:text-properties fo:font-size="10pt"/></style:style><style:style style:name="chPlot" style:family="chart"><style:chart-properties chart:vertical="false" chart:treat-empty-cells="leave-gap"/></style:style><style:style style:name="chAxis" style:family="chart"><style:chart-properties chart:display-label="true"/><style:graphic-properties svg:stroke-color="#b3b3b3"/><style:text-properties fo:font-size="10pt"/></style:style><style:style style:name="chGrid" style:family="chart"><style:graphic-properties svg:stroke-color="#d9d9d9"/></style:style><style:style style:name="chWall" style:family="chart"><style:graphic-properties draw:stroke="none" draw:fill="none"/></style:style><style:style style:name="chPie" style:family="chart"><style:graphic-properties draw:stroke="solid" svg:stroke-color="#ffffff"/></style:style><style:style style:name="chS0" style:family="chart"><style:graphic-properties draw:stroke="none" draw:fill="solid" draw:fill-color="#4472c4"/></style:style></office:automatic-styles><office:body><office:chart><chart:chart svg:width="450.00pt" svg:height="270.00pt" chart:class="chart:bar" chart:style-name="chMain"><chart:title chart:style-name="chTitle"><text:p>Sales</text:p></chart:title><chart:legend chart:legend-position="end" chart:style-name="chLegend"/><chart:plot-area chart:style-name="chPlot" table:cell-range-address="local-table.$A$1:.$B$3" chart:data-source-has-labels="both"><chart:axis chart:dimension="x" chart:name="primary-x" chart:style-name="chAxis"><chart:categories table:cell-range-address="local-table.$A$2:.$A$3"/></chart:axis><chart:axis chart:dimension="y" chart:name="primary-y" chart:style-name="chAxis"><chart:grid chart:class="major" chart:style-name="chGrid"/></chart:axis><chart:series chart:style-name="chS0" chart:class="chart:bar" chart:values-cell-range-address="local-table.$B$2:.$B$3" chart:label-cell-address="local-table.$B$1"><chart:data-point chart:repeated="2"/></chart:series><chart:wall chart:style-name="chWall"/><chart:floor chart:style-name="chWall"/></chart:plot-area><table:table table:name="local-table"><table:table-header-columns><table:table-column/></table:table-header-columns><table:table-columns><table:table-column table:number-columns-repeated="1"/></table:table-columns><table:table-header-rows><table:table-row><table:table-cell><text:p/></table:table-cell><table:table-cell office:value-type="string"><text:p>s</text:p></table:table-cell></table:table-row></table:table-header-rows><table:table-rows><table:table-row><table:table-cell office:value-type="string"><text:p>March</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="90"><text:p>90</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>April</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="120"><text:p>120</text:p></table:table-cell></table:table-row></table:table-rows></table:table></chart:chart></office:chart></office:body></office:document></draw:object><svg:desc>{% if not chart %}{{ drop("chart") }}{% endif %}</svg:desc></draw:frame>
<draw:custom-shape draw:name="Stamp"  svg:width="4cm" svg:height="1.2cm" svg:x="15cm" svg:y="13cm"><text:p>Stamp{{ drop("shape") if not stamp }}</text:p><draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="rectangle" draw:enhanced-path="M 0 0 L 21600 0 21600 21600 0 21600 Z N"/></draw:custom-shape>
</draw:page>
<draw:page draw:name="page2" draw:master-page-name="Default">
<draw:frame svg:x="1cm" svg:y="1cm" svg:width="12cm" svg:height="2cm"><draw:text-box><text:p>Appendix{{ drop("slide") if not appendix }}</text:p></draw:text-box></draw:frame>
</draw:page>
<draw:page draw:name="page3" draw:master-page-name="Default">
<draw:frame svg:x="1cm" svg:y="1cm" svg:width="12cm" svg:height="2cm"><draw:text-box><text:p>Thanks</text:p></draw:text-box></draw:frame>
</draw:page>
</office:presentation>
</office:body>
</office:document>
