<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:presentation="urn:oasis:names:tc:opendocument:xmlns:presentation:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
<office:automatic-styles><style:style style:name="fr1" style:family="graphic"><style:graphic-properties fo:border="1.5pt solid #1f6f3f" fo:padding="0pt" style:wrap="none"/></style:style><style:style style:name="fr2" style:family="graphic"><style:graphic-properties fo:border="1.5pt solid #1f6f3f" style:wrap="parallel" style:vertical-pos="top" style:horizontal-pos="right" style:horizontal-rel="paragraph"/></style:style></office:automatic-styles>
<office:body><office:text>
<text:p>Contain <draw:frame draw:style-name="fr1" draw:name="Contain" text:anchor-type="as-char" svg:width="120pt" svg:height="120pt"><draw:image><office:binary-data></office:binary-data></draw:image><svg:desc>{{ logo | image }}</svg:desc></draw:frame></text:p>
<text:p>Cover <draw:frame draw:style-name="fr1" draw:name="Cover" text:anchor-type="as-char" svg:width="120pt" svg:height="120pt"><draw:image><office:binary-data></office:binary-data></draw:image><svg:desc>{{ logo | image(fit="cover") }}</svg:desc></draw:frame></text:p>
<text:p>Width <draw:frame draw:style-name="fr1" draw:name="Width" text:anchor-type="as-char" svg:width="120pt" svg:height="120pt"><draw:image><office:binary-data></office:binary-data></draw:image><svg:desc>{{ logo | image(fit="width") }}</svg:desc></draw:frame></text:p>
<text:p>Stretch <draw:frame draw:style-name="fr1" draw:name="Stretch" text:anchor-type="as-char" svg:width="120pt" svg:height="60pt"><draw:image><office:binary-data></office:binary-data></draw:image><svg:desc>{{ logo | image(fit="stretch") }}</svg:desc></draw:frame></text:p>
<text:p><draw:frame draw:style-name="fr2" draw:name="Wrapped" text:anchor-type="paragraph" svg:width="90pt" svg:height="90pt"><draw:image><office:binary-data></office:binary-data></draw:image><svg:desc>{{ drawing | image }}</svg:desc></draw:frame>Wrapped text flows beside a placeholder that holds an SVG drawing, at the right of this paragraph. More words so the paragraph wraps around the frame on the left side of it.</text:p>
<text:p>Code <draw:frame draw:style-name="fr1" draw:name="Code" text:anchor-type="as-char" svg:width="160pt" svg:height="80pt"><draw:image><office:binary-data></office:binary-data></draw:image><svg:desc>{{ sku | barcode("ean13", text=true) }}</svg:desc></draw:frame></text:p>
<table:table table:name="Items">
<table:table-column table:number-columns-repeated="2"/>
<table:table-row>
<table:table-cell office:value-type="string"><text:p>{% for i in items %}{{ i.name }}</text:p></table:table-cell>
<table:table-cell office:value-type="string"><text:p><draw:frame draw:style-name="fr1" draw:name="Item" text:anchor-type="as-char" svg:width="40pt" svg:height="40pt"><draw:image><office:binary-data></office:binary-data></draw:image><svg:desc>{{ i.photo | image(fit="cover") }}</svg:desc></draw:frame>{% endfor %}</text:p></table:table-cell>
</table:table-row>
</table:table>
<text:p>End</text:p>
</office:text></office:body></office:document>
