---
import Base from '../layouts/Base.astro';
const proven: [string, string][] = [
  ['Automated tests', 'The unit and integration tests pass on every commit, along with the linter and a dependency audit.'],
  ['Several containers on one store', 'Run with three replicas on minikube, and against an S3 gateway and a shared volume.'],
  ['Attacks at full size', 'Run in a container limited to 3 GiB. See the security page for the results.'],
  ['Documentation examples', 'The shell examples marked as tested run against the real image.'],
  ['Microsoft Office on a Mac', 'Templates typed in Word, Excel and PowerPoint 16.114 for Mac were filled, and the results open in the same apps with no repair prompt. The run found three faults, now fixed: Excel repaired workbooks with a stale calculation chain, a loop across two shapes on one slide printed copies on top of each other, and charts and pictures in unmoved placeholders went to the corner.'],
  ['PDF viewers', 'Filled forms, editable and flattened, show their values in Chrome 154 and in Preview on macOS 27.'],
  ['Barcodes', 'All five symbologies decode to their exact value with ZXing and ZBar, from the document and from its PDF at 150 and 300 dpi.'],
  ['Output across architectures', 'Fourteen outputs rendered by the amd64 and arm64 images: the Office and text files and a filled PDF form are byte-identical, and LibreOffice\'s PDFs match as page images or in layout within 0.25 pt.'],
  ['PDF signatures', 'Signed files validate in poppler\'s pdfsig, which finds the signature valid and covering the whole document, and in pyHanko, which judges them VALID.'],
];
const open: [string, string][] = [
  ['Office for Windows', 'Only the Mac versions of Word, Excel and PowerPoint have opened the output.'],
  ['Adobe Acrobat', 'Filled forms and signed files haven\'t been opened in Acrobat or Acrobat Reader.'],
  ['Barcode scanners', 'Software decoders read every code. No hardware or phone scanner has been tried.'],
  ['AWS and production Kubernetes', 'Storage has run on an S3 gateway and minikube, not on AWS itself or a production cluster.'],
  ['Production use', 'This is a first release, and it hasn\'t carried production traffic yet.'],
];
const missing = [
  'Text the service draws into a PDF is Latin only. Other characters draw as ?, though the stored field value stays complete.',
  'A template using a font the service lacks isn\'t reported. Word\'s default font, Aptos, isn\'t in the image, so upload it or use another font.',
  'Repeating a whole sheet in XLSX or ODS isn\'t supported, nor are charts in ODF templates.',
  'Stored templates have no versions or aliases, so an edit produces a new id.',
  'PDF signatures have no timestamp from a timestamp authority (PAdES B-B only, not B-T or LTV), and there is one signing key per deployment.',
];
---
<Base title="Status: rusticdoc" description="What has been proven in rusticdoc 0.1, what hasn't, and what's still missing." path="/status/">
  <header class="page-head">
    <h1>What's proven, and what isn't yet</h1>
    <p>Version 0.1 is the first release. Before you depend on it, here's what has been run and what hasn't.</p>
  </header>
  <section class="band">
    <div class="wrap prose">
      <h2>Proven by running it</h2>
      <dl class="status-list">
        {proven.map(([k, v]) => <div><dt>{k} <span class="pill ok">Proven</span></dt><dd>{v}</dd></div>)}
      </dl>
      <h2>Not yet checked</h2>
      <dl class="status-list">
        {open.map(([k, v]) => <div><dt>{k} <span class="pill warn">Not checked</span></dt><dd>{v}</dd></div>)}
      </dl>
      <h2>Known gaps</h2>
      <ul>{missing.map((m) => <li>{m}</li>)}</ul>
      <p class="more"><a href="/docs/project/known-limits/">See every known limit</a></p>
      <p class="more"><a href="/docs/project/roadmap/">See what's next</a></p>
    </div>
  </section>
</Base>
