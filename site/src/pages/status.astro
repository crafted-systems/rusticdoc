---
import Base from '../layouts/Base.astro';
const proven: [string, string][] = [
  ['Gotenberg 8.39 parity', '310 of its 326 scenarios behave the same. The other 16 select PDFtk or expect Chromium in a status response.'],
  ['Automated tests', 'The unit and integration tests pass on every commit, along with the linter and a dependency audit.'],
  ['Several containers on one store', 'Run with three replicas on minikube, and against an S3 gateway and a shared volume.'],
  ['Attacks at full size', 'Run in a container limited to 3 GiB. See the security page for the results.'],
  ['Documentation examples', 'The shell examples marked as tested run against the real image.'],
];
const open: [string, string][] = [
  ['Microsoft Office', 'Generated DOCX, XLSX and PPTX files have been opened in LibreOffice, not in Word, Excel or PowerPoint. A repair prompt hasn\'t been ruled out.'],
  ['PDF viewers', 'Filled forms haven\'t been viewed in Chrome, Acrobat Reader or Preview.'],
  ['Barcode readers', 'One QR code was decoded with OpenCV. No barcode has been scanned with a physical reader.'],
  ['AWS and production Kubernetes', 'Storage has run on an S3 gateway and minikube, not on AWS itself or a production cluster.'],
  ['Output across architectures', 'Output is checked by content. There\'s no set of reference PDFs to compare byte for byte on amd64 and arm64.'],
  ['Production use', 'This is a first release, and it hasn\'t carried production traffic yet.'],
];
const missing = [
  'Text the service draws into a PDF is Latin only. Other characters draw as ?, though the stored field value stays complete.',
  'A template using a font the service lacks isn\'t reported.',
  'Repeating a whole sheet in XLSX or ODS isn\'t supported, nor are charts in ODF templates.',
  'Stored templates have no versions or aliases, so an edit produces a new id.',
];
---
<Base title="Status: rusticdoc" description="What has been proven in rusticdoc 0.1, what hasn't, and what's still missing." path="/status/">
  <header class="page-head">
    <h1>What's proven, and what isn't yet</h1>
    <p>Version 0.1 is the first release. Before you depend on it, here's what has been run and what hasn't.</p>
  </header>
  <section class="band">
    <div class="wrap prose">
      <h2>Proven by running it</h2>
      <dl class="status-list">
        {proven.map(([k, v]) => <div><dt>{k} <span class="pill ok">Proven</span></dt><dd>{v}</dd></div>)}
      </dl>
      <h2>Not yet checked</h2>
      <dl class="status-list">
        {open.map(([k, v]) => <div><dt>{k} <span class="pill warn">Not checked</span></dt><dd>{v}</dd></div>)}
      </dl>
      <h2>Known gaps</h2>
      <ul>{missing.map((m) => <li>{m}</li>)}</ul>
      <p class="more"><a href="/docs/project/known-limits/">See every known limit</a></p>
      <p class="more"><a href="/docs/project/roadmap/">See what's next</a></p>
    </div>
  </section>
</Base>
