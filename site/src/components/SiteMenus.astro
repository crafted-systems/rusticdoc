---
// The two menus every page's top bar carries, on the marketing pages and in the
// docs alike: what rusticdoc is, and how to use it. Each is a disclosure that
// works without JavaScript; a small script closes the others, and closes on
// Escape or a click elsewhere.
interface Props {
  /** The page's path, to mark the menu it belongs to. */
  path: string;
}
const { path } = Astro.props;

const menus = [
  {
    label: 'Product',
    current: path === '/',
    items: [
      { href: '/#how-it-works', title: 'How it works', text: 'A template and JSON in, a finished document out' },
      { href: '/#formats', title: 'Formats', text: 'The templates it reads and the files it writes' },
      { href: '/#made-for', title: 'What it is for', text: 'Invoices, contracts, statements and forms' },
      { href: '/#building-blocks', title: 'Building blocks', text: 'Templates, conversion and PDF steps in one request' },
      { href: '/#run-it', title: 'Run it your way', text: 'One container, on your own servers' },
      { href: '/#questions', title: 'Questions', text: 'What people ask before they start' },
    ],
  },
  {
    label: 'Docs',
    current: path.startsWith('/docs/') || path === '/security/' || path === '/status/',
    items: [
      { href: '/docs/start/quickstart/', title: 'Quickstart', text: 'Fill your first template in five minutes' },
      { href: '/docs/templates/syntax/', title: 'Write templates', text: 'Tags, loops, conditions and filters' },
      { href: '/docs/reference/api/', title: 'HTTP API', text: 'Every route, field and answer' },
      { href: '/docs/operate/docker/', title: 'Run it', text: 'Docker, Kubernetes, sizing and logs' },
      { href: '/security/', title: 'Security', text: 'How it handles documents from strangers' },
      { href: '/status/', title: 'Status', text: 'What has been proven, and what has not' },
      { href: '/docs/project/changelog/', title: 'Changelog', text: 'What each release contains' },
    ],
  },
];
---
<div class="site-menus">
  {menus.map((menu) => (
    <details class="site-menu" data-site-menu>
      <summary aria-current={menu.current ? 'true' : undefined}>
        {menu.label}
        <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.75" /></svg>
      </summary>
      <ul class="site-menu-panel">
        {menu.items.map((item) => (
          <li>
            <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
              <span class="site-menu-title">{item.title}</span>
              <span class="site-menu-text">{item.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </details>
  ))}
</div>

<style>
  .site-menus { position: relative; display: flex; align-items: center; gap: 0.25rem; }
  .site-menu { position: relative; }
  summary {
    display: inline-flex; align-items: center; gap: 0.35rem; list-style: none; cursor: pointer;
    color: var(--ink); font-size: 0.98rem; font-weight: 500; line-height: 1.5;
    padding: 0.42rem 0.8rem; border-radius: var(--r-small);
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover, .site-menu[open] summary { background: var(--blue-wash); color: var(--blue-deep); }
  summary[aria-current='true'] { color: var(--blue-deep); font-weight: 600; }
  summary:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
  summary svg { transition: transform 150ms; }
  .site-menu[open] summary svg { transform: rotate(180deg); }
  @media (prefers-reduced-motion: reduce) { summary svg { transition: none; } }

  .site-menu-panel {
    position: absolute; top: calc(100% + 0.4rem); left: 0; z-index: 30;
    display: grid; gap: 0.15rem; width: min(22rem, calc(100vw - 2rem));
    margin: 0; padding: 0.4rem; list-style: none;
    background: var(--card); border: 1px solid var(--line-strong); border-radius: var(--r-panel);
    box-shadow: var(--shadow-panel);
  }
  /* The last menu opens towards the left, so it stays on screen near the edge. */
  .site-menu:last-child .site-menu-panel { left: auto; right: 0; }
  .site-menu-panel li { margin: 0; }
  .site-menu-panel a {
    display: grid; gap: 0.1rem; padding: 0.55rem 0.7rem; border-radius: var(--r-small);
    text-decoration: none; color: var(--ink);
  }
  .site-menu-panel a:hover, .site-menu-panel a:focus-visible { background: var(--blue-wash); }
  .site-menu-panel a[aria-current='page'] { background: var(--blue-wash); }
  .site-menu-title { font-weight: 600; font-size: 0.95rem; line-height: 1.35; }
  .site-menu-text { color: var(--ink-soft); font-size: 0.85rem; line-height: 1.4; }
  .site-menu-panel a:hover .site-menu-title, .site-menu-panel a[aria-current='page'] .site-menu-title { color: var(--blue-deep); }

  @media (max-width: 640px) {
    summary { padding: 0.35rem 0.6rem; font-size: 0.95rem; }
    /* On a phone both panels hang from the start of the menus, which sit near
       the left edge, so neither runs off the screen. */
    .site-menu { position: static; }
    .site-menu .site-menu-panel,
    .site-menu:last-child .site-menu-panel { left: 0; right: auto; }
  }
</style>

<script>
  const menus = () => [...document.querySelectorAll<HTMLDetailsElement>('[data-site-menu]')];
  for (const menu of menus()) {
    menu.addEventListener('toggle', () => {
      if (!menu.open) return;
      for (const other of menus()) if (other !== menu) other.open = false;
    });
  }
  document.addEventListener('click', (event) => {
    const inside = (event.target as Element).closest?.('[data-site-menu]');
    for (const menu of menus()) if (menu !== inside) menu.open = false;
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    for (const menu of menus()) {
      if (!menu.open) continue;
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
</script>
