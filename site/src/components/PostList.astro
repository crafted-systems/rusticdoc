---
// Blog posts, newest first: the blog's home page and each year's page list
// them the same way. The first post is featured, its cover beside its title,
// summary and author. The rest follow in a grid of three: cover, label, title
// and date, with no box around them.
import { Image } from 'astro:assets';
import Byline from './Byline.astro';
import { longDate, postPath, readingTime, type Post } from '../blog';

interface Props { posts: Post[] }
const { posts } = Astro.props;
const [first, ...rest] = posts;
---
{first ? (
  <div class="posts">
    <article class="featured">
      <a class="cover" href={postPath(first)} tabindex="-1" aria-hidden="true">
        <Image src={first.data.cover} alt="" widths={[640, 960, 1440]} sizes="(min-width: 60rem) 40rem, 92vw" loading="eager" />
      </a>
      <div class="featured-text">
        {first.data.tag && <p class="tag">{first.data.tag}</p>}
        <h2><a href={postPath(first)}>{first.data.title}</a></h2>
        <p class="summary">{first.data.description}</p>
        <div class="featured-foot">
          <Byline author={first.data.author} detail={`${longDate(first.data.date)} · ${readingTime(first)} min read`} />
        </div>
      </div>
    </article>
    {rest.length > 0 && (
      <ul class="grid">
        {rest.map((p) => (
          <li>
            <article class="item">
              <a class="cover" href={postPath(p)} tabindex="-1" aria-hidden="true">
                <Image src={p.data.cover} alt="" widths={[480, 800]} sizes="(min-width: 60rem) 24rem, (min-width: 40rem) 46vw, 92vw" />
              </a>
              {p.data.tag && <p class="tag">{p.data.tag}</p>}
              <h3><a href={postPath(p)}>{p.data.title}</a></h3>
              <p class="date"><time datetime={p.data.date.toISOString()}>{longDate(p.data.date)}</time></p>
            </article>
          </li>
        ))}
      </ul>
    )}
  </div>
) : (
  <p class="measure">Nothing here yet.</p>
)}

<style>
  .posts { display: grid; gap: clamp(3rem, 6vw, 4.5rem); }

  /* Covers: rounded, on a hairline, and lifting a little under the mouse. */
  .cover { display: block; overflow: hidden; border-radius: 8px; border: 1px solid var(--line); background: var(--card); }
  .cover :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 1200 / 630; object-fit: cover; transition: transform 300ms ease; }
  article:hover .cover :global(img) { transform: scale(1.02); }

  .tag { margin: 0 0 0.5rem; color: var(--blue-deep); font-size: 0.88rem; font-weight: 600; }
  h2 a, h3 a { color: var(--ink); text-decoration: none; }
  h2 a:hover, h3 a:hover { color: var(--blue-deep); }

  .featured { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3rem); align-items: stretch; }
  .featured-text { display: flex; flex-direction: column; padding-block: 0.25rem; }
  .featured h2 { font-size: clamp(1.7rem, 3vw, 2.3rem); font-weight: 600; letter-spacing: -0.025em; line-height: 1.12; margin: 0 0 0.75rem; }
  .summary { color: var(--ink-soft); font-size: 1.05rem; line-height: 1.55; margin: 0; }
  .featured-foot { margin-top: auto; padding-top: 1.75rem; }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.75rem 2rem; }
  .item .cover { margin-bottom: 1rem; }
  .item h3 { font-size: 1.2rem; font-weight: 600; line-height: 1.3; letter-spacing: -0.01em; margin: 0 0 0.4rem; }
  .date { margin: 0; color: var(--ink-soft); font-size: 0.9rem; }

  @media (prefers-reduced-motion: reduce) {
    .cover :global(img) { transition: none; }
    article:hover .cover :global(img) { transform: none; }
  }
  @media (max-width: 860px) {
    .featured { grid-template-columns: minmax(0, 1fr); }
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
