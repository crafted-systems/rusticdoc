---
const options = [
  { value: 'light', label: 'Light', path: 'M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4' },
  { value: 'dark', label: 'Dark', path: 'M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z' },
  { value: 'auto', label: 'Match device', path: 'M4 5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM9 21h6M12 17v4' },
];
---
<div class="theme-switch" role="group" aria-label="Colour theme">
  {options.map((o) => (
    <button type="button" data-theme-choice={o.value} aria-pressed="false" aria-label={o.label} title={o.label}>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={o.path} /></svg>
    </button>
  ))}
</div>
<noscript><style is:inline>.theme-switch { display: none !important; }</style></noscript>

<style>
  .theme-switch { display: inline-flex; flex: none; align-self: center; gap: 0.125rem; padding: 0.1875rem; background: var(--card); border: 1px solid var(--line-strong); border-radius: var(--r-small); }
  button {
    appearance: none; display: grid; place-items: center; width: 1.75rem; height: 1.75rem; padding: 0;
    border: 0; border-radius: var(--r-small); background: transparent; color: var(--ink-soft); cursor: pointer;
  }
  button:hover { color: var(--blue-deep); }
  /* The pressed look follows the choice the head script puts on the root element,
     so it is right in the first paint rather than after this script runs. */
  :global(:root[data-theme-choice='light']) button[data-theme-choice='light'],
  :global(:root[data-theme-choice='dark']) button[data-theme-choice='dark'],
  :global(:root[data-theme-choice='auto']) button[data-theme-choice='auto'] { background: var(--blue-wash); color: var(--blue-deep); }
  button:focus-visible { outline: 3px solid var(--blue); outline-offset: 1px; }
</style>

<script>
  type Choice = 'light' | 'dark' | 'auto';
  const key = 'starlight-theme';
  const load = (): Choice => {
    try {
      const value = localStorage.getItem(key);
      return value === 'light' || value === 'dark' ? value : 'auto';
    } catch { return 'auto'; }
  };
  const save = (choice: Choice) => {
    try { localStorage.setItem(key, choice === 'auto' ? '' : choice); } catch {}
  };
  const device = () => (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
  const apply = (choice: Choice) => {
    document.documentElement.dataset.theme = choice === 'auto' ? device() : choice;
    document.documentElement.dataset.themeChoice = choice;
    for (const button of document.querySelectorAll<HTMLElement>('[data-theme-choice]')) {
      button.setAttribute('aria-pressed', String(button.dataset.themeChoice === choice));
    }
  };
  apply(load());
  document.addEventListener('click', (event) => {
    const button = (event.target as Element).closest?.<HTMLElement>('[data-theme-choice]');
    if (!button) return;
    const choice = button.dataset.themeChoice as Choice;
    save(choice);
    apply(choice);
  });
  matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
    if (load() === 'auto') apply('auto');
  });
</script>
