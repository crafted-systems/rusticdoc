---
// Who wrote a post: initials in a circle (or the logo, for the team), their
// name, and a second line such as the date or where they work.
import Logo from './Logo.astro';
import { initials } from '../blog';

interface Props {
  author: string;
  /** The line under the name. */
  detail?: string;
  size?: 'small' | 'large';
}
const { author, detail, size = 'small' } = Astro.props;
const letters = initials(author);
---
<p class:list={['byline', size]}>
  <span class="avatar" aria-hidden="true">{letters ? <span>{letters}</span> : <Logo />}</span>
  <span class="who"><span class="name">{author}</span>{detail && <span class="detail">{detail}</span>}</span>
</p>

<style>
  .byline { display: flex; align-items: center; gap: 0.65rem; margin: 0; line-height: 1.3; }
  .avatar {
    display: inline-grid; place-items: center; flex: none; width: 2.1rem; height: 2.1rem; border-radius: 50%;
    background: var(--tint); border: 1px solid var(--line-strong);
    color: var(--ink); font-size: 0.78rem; font-weight: 650; letter-spacing: 0.02em;
  }
  .large .avatar { width: 3rem; height: 3rem; font-size: 1rem; }
  .avatar :global(svg) { width: 60%; height: 60%; }
  .who { display: grid; gap: 0.1rem; }
  .name { color: var(--ink); font-weight: 600; font-size: 0.92rem; }
  .detail { color: var(--ink-soft); font-size: 0.88rem; }
</style>
